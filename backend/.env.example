# Copy file này thành "backend/.env" rồi điền giá trị thật — "backend/.env"
# không nằm trong git (chứa secret), chỉ file .env.example này được commit.
#
#   cp backend/.env.example backend/.env      (Linux/Mac/Git Bash)
#   copy backend\.env.example backend\.env    (Windows cmd/PowerShell)

# Khoá bí mật dùng để đăng ký thiết bị chấm công mới (xem mục 3 trong README).
# Tự đặt 1 chuỗi bất kỳ đủ khó đoán.
DEVICE_SETUP_KEY=doi-thanh-chuoi-bi-mat-cua-ban

# Chuỗi kết nối PostgreSQL.
# - Cách A (chạy backend bằng Docker): KHÔNG CẦN sửa dòng dưới — docker-compose.yml
#   tự ghép đúng giá trị (dùng hostname "postgres") và ghi đè giá trị này.
# - Cách B (chạy "python run.py" trực tiếp, không qua Docker): PHẢI sửa lại
#   đúng user/mật khẩu/tên DB khớp với file ".env" ở thư mục gốc, và dùng
#   "localhost" vì lúc này backend chạy thẳng trên máy, không qua mạng Docker.
DATABASE_URL=postgresql://faceid_app:faceid_dev_pw@localhost:5432/cnm_faceid

# Khoá ký JWT (token đăng nhập) — sinh bằng lệnh:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=doi-thanh-chuoi-hex-64-ky-tu-cua-ban

# --- Cookie JWT (xem app/__init__.py) ---
# Origin của frontend (Vite dev server) — CORS cần biết chính xác để cho phép
# gửi kèm cookie (supports_credentials).
FRONTEND_ORIGIN=http://localhost:5173
# true khi chạy production qua HTTPS thật. Để false khi dev local qua http://
# — nếu để true lúc dev, trình duyệt sẽ âm thầm không lưu cookie.
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# --- SMTP: dùng để gửi mật khẩu mới khi admin reset mật khẩu nhân viên ---
# Tuỳ chọn — chưa điền thì tính năng reset mật khẩu sẽ báo lỗi rõ ràng thay vì
# âm thầm đổi mật khẩu mà không gửi được mail. Ví dụ dùng Gmail:
# SMTP_HOST là smtp.gmail.com, SMTP_USER là địa chỉ Gmail, SMTP_PASSWORD là
# "App Password" (KHÔNG dùng mật khẩu Gmail thường).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
